Options -Indexes
RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirigir /index e /index.html a la raíz
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{REQUEST_URI} ^/index/?$
RewriteRule ^ / [R=301,L]

# Quitar la extensión .html de las URLs
# Si alguien entra a /contacto.html → redirige a /contacto (301 permanente)
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Servir el archivo .html cuando alguien pide la URL sin extensión
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Página de inicio limpia
DirectoryIndex index.html
